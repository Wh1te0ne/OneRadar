# Shared
ONERADAR_ENV=development
ONERADAR_LOG_LEVEL=INFO

# API
ONERADAR_API_HOST=0.0.0.0
ONERADAR_API_PORT=8000
ONERADAR_API_SECRET_KEY=change-me

# Database
ONERADAR_POSTGRES_DB=oneradar
ONERADAR_POSTGRES_USER=oneradar
ONERADAR_POSTGRES_PASSWORD=oneradar
ONERADAR_DATABASE_URL=postgresql+psycopg://oneradar:oneradar@postgres:5432/oneradar

# Redis
ONERADAR_REDIS_URL=redis://redis:6379/0

# Storage
ONERADAR_STORAGE_ROOT=/app/data/storage

# Worker
ONERADAR_WORKER_CONCURRENCY=2

# Optional Bilibili credentials for subtitle access
# ONERADAR_BILIBILI_SESSDATA=
# ONERADAR_BILIBILI_BILI_JCT=
# ONERADAR_BILIBILI_BUVID3=

# Desktop
VITE_ONERADAR_DEFAULT_API_URL=http://127.0.0.1:8000
# Desktop dev server proxy target (used by 
pm run dev)
VITE_ONERADAR_DEV_API_PROXY_TARGET=http://127.0.0.1:8000

